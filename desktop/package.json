{
  "name": "checkwriter",
  "productName": "CheckWriter",
  "version": "1.3.0",
  "description": "Business check writer, designer and print preparation",
  "main": "main.cjs",
  "author": {
    "name": "RichCo Enterprises LLC"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build-info": "node scripts/write-build-info.mjs",
    "icons": "python3 scripts/make-icon.py",
    "dist:win": "node scripts/write-build-info.mjs && node scripts/fetch-native.mjs win32 x64 && electron-builder --win --x64 --publish never",
    "dist:mac": "node scripts/build-mac.mjs",
    "dist:mac:publish": "node scripts/build-mac.mjs --publish always"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "42.11.6",
    "electron-builder": "^26.0.12",
    "js-yaml": "^4.3.2",
    "node-abi": "^3.96.0"
  }
}
