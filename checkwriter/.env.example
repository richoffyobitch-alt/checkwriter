# CheckWriter — environment configuration
# Copy to `.env` and replace every value before running outside the demo sandbox.

# development | production
NODE_ENV=development

# HTTP port for the combined API + static server
PORT=5000

# Signs session cookies / bearer tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value invalidates all active sessions.
SESSION_SECRET=replace-me-with-32-random-bytes-hex

# AES-256-GCM key for bank routing/account numbers at rest. MUST be 64 hex
# characters (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# WARNING: losing or changing this key makes every stored bank account
# undecryptable. In real deployments hold it in a managed secret store (AWS KMS,
# GCP Secret Manager, Vault) and never in a file on the app server.
ENCRYPTION_KEY=replace-me-with-64-hex-characters
